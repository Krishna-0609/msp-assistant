# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# DynamoDB
DYNAMODB_TABLE_COSTS=msp-costs
DYNAMODB_TABLE_ALERTS=msp-alerts
DYNAMODB_TABLE_USERS=msp-users
DYNAMODB_TABLE_CHAT=msp-chat

# S3
S3_BUCKET=msp-assistant-data

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Database
DATABASE_URL=postgresql://user:password@localhost/msp_assistant

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notifications
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
