# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# JWT
SECRET_KEY=msp-assistant-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS - Using AWS Profile from ~/.aws/credentials (Mumbai Region)
AWS_REGION=ap-south-1
AWS_PROFILE=default
# For direct credentials, uncomment and set:
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB
DYNAMODB_TABLE_COSTS=msp-costs
DYNAMODB_TABLE_ALERTS=msp-alerts
DYNAMODB_TABLE_USERS=msp-users
DYNAMODB_TABLE_CHAT=msp-chat

# S3
S3_BUCKET=msp-assistant-data

# Bedrock (Mumbai Region - Claude Sonnet 4.6)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=ap-south-1

# Database
DATABASE_URL=sqlite:///./msp_assistant.db

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Notifications - Teams Integration
TEAMS_WEBHOOK_URL=https://your-teams-webhook-url
# For Slack (optional):
# SLACK_WEBHOOK_URL=https://your-slack-webhook-url

# YouTrack Integration
YOUTRACK_URL=https://your-youtrack-instance.com
YOUTRACK_TOKEN=your-youtrack-api-token
YOUTRACK_PROJECT=MSP
YOUTRACK_ISSUE_LINK_BASE=https://your-youtrack-instance.com/issues

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.1.43:3000
